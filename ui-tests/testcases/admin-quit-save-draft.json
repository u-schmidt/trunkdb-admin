{
  "name": "admin-quit-save-draft",
  "steps": [
    "@admin-open-people",
    "Click New document.",
    "Type {\"name\": \"Test Person\"} into the new document's JSON.",
    "Press ⌘Q.",
    "Click Save.",
    "Assert that the app is not running."
